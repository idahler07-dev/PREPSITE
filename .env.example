# Copy to .env and fill in. Never commit .env.
# Values marked REQUIRED must be set in every environment.

# ─── Core ────────────────────────────────────────────────────────────────────
# REQUIRED. Local: docker compose up -d (see docker-compose.yml)
DATABASE_URL="postgresql://prep:prep@localhost:5432/prepsite"
# Public base URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Auth (Auth.js) ──────────────────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Set to the public URL in production (Auth.js uses it for callbacks)
AUTH_URL="http://localhost:3000"
# Google sign-in (optional). https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Telegram Login (optional). Create a bot with @BotFather, then /setdomain to your site domain.
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
# Comma-separated emails that become admins when they sign in
ADMIN_EMAILS="you@example.com"

# ─── Email ───────────────────────────────────────────────────────────────────
# outbox = development only: emails are written to .data/dev-mail and printed to the console
# smtp   = any SMTP server (SMTP_URL)
# resend = Resend API (RESEND_API_KEY)
# Sign-in emails per IP address per hour. A classroom behind one IP may need more.
MAGIC_LINKS_PER_IP_HOUR="10"
EMAIL_TRANSPORT="outbox"
EMAIL_FROM="PrepSite <no-reply@example.com>"
RESEND_API_KEY=""
# e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=""

# ─── File storage (private) ──────────────────────────────────────────────────
# local = files on disk under STORAGE_LOCAL_DIR (development / single VPS)
# s3    = S3-compatible storage: Cloudflare R2 in production, MinIO locally
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/storage"
# MinIO (docker compose): http://localhost:9000, bucket prepsite-private, minioadmin/minioadmin
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com, region "auto"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="prepsite-private"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# true for MinIO, false for R2
S3_FORCE_PATH_STYLE="true"

# ─── AI (Anthropic) — server-side only ───────────────────────────────────────
# Used for PDF reading (scans, math as LaTeX, figure cropping), the AI tutor and AI-drafted questions.
# Daily per-student limits are in src/config/ai-limits.ts; prices for cost estimates in src/config/ai-pricing.ts.
# Without a key, only typed PDFs can be imported (from their text layer).
ANTHROPIC_API_KEY=""
AI_MODEL_FAST="claude-haiku-5-5"
AI_MODEL_SMART="claude-sonnet-5-5"

# ─── Background jobs (PDF import) ────────────────────────────────────────────
# worker   = a worker runs inside the Next.js server (VPS / `pnpm start`) — default
# external = jobs are only queued; a cron calls POST /api/jobs/run with
#            "Authorization: Bearer $CRON_SECRET" every minute (serverless hosts)
# inline   = jobs run immediately in the request (tests only)
JOBS_MODE="worker"
CRON_SECRET=""

# ─── Test tools ──────────────────────────────────────────────────────────────
# Desmos API key (Phase 3). Without it a basic scientific calculator is shown.
DESMOS_API_KEY=""

# ─── Payments ────────────────────────────────────────────────────────────────
# Comma-separated, any of: mock,payme,click,octo. Prices are in src/config/plans.ts.
# UZS is paid with Payme or Click (Uzcard/Humo); USD with Octo (international cards).
# Card numbers never touch this site: every provider uses its own hosted checkout.
PAYMENT_PROVIDERS="mock"
# Mock provider (development and tests only; refused in production unless ALLOW_MOCK_PAYMENTS=true)
MOCK_PAYMENT_SECRET="dev-mock-payment-secret"
ALLOW_MOCK_PAYMENTS=""
# Payme (Paycom) merchant. Endpoint URL to enter in the Payme cabinet: https://<your-domain>/api/payments/payme/webhook
PAYME_MERCHANT_ID=""
PAYME_KEY=""
PAYME_SANDBOX="true"
# Click. Prepare and Complete URLs to enter in the Click cabinet: https://<your-domain>/api/payments/click/webhook
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_MERCHANT_USER_ID=""
CLICK_SECRET_KEY=""
# Octo (international cards, USD). Notify URL: https://<your-domain>/api/payments/octo/webhook
OCTO_SHOP_ID=""
OCTO_SECRET=""
OCTO_TEST="true"

# ─── Monitoring (optional) ───────────────────────────────────────────────────
SENTRY_DSN=""
