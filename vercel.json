{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm db:deploy && pnpm db:seed && pnpm build",
  "crons": [{ "path": "/api/jobs/run", "schedule": "50 13 * * *" }],
  "functions": {
    "src/app/api/jobs/run/route.ts": { "maxDuration": 60 },
    "src/app/api/ai/**/route.ts": { "maxDuration": 60 },
    "src/app/api/admin/imports/**/route.ts": { "maxDuration": 60 }
  }
}
