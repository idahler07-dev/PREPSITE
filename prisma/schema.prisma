// Database schema. After editing run: pnpm db:migrate
// Docs: https://www.prisma.io/docs/orm/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users & auth ───────────────────────────────────────────────────────────

enum Role {
  STUDENT
  EDITOR // enters, imports and reviews questions
  ADMIN // everything, including users, settings and payments
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String?         @unique
  emailVerified    DateTime?
  image            String?
  role             Role            @default(STUDENT)
  /// null = the user has not picked a language yet (browser language is used)
  locale           String?
  theme            ThemePreference @default(SYSTEM)
  timeZone         String          @default("Asia/Tashkent")
  telegramId       String?         @unique
  telegramUsername String?

  // Onboarding / goals
  testDate     DateTime? @db.Date
  targetScore  Int?
  currentScore Int?
  onboardedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  attempts          Attempt[]
  questionReports   QuestionReport[]  @relation("ReportAuthor")
  resolvedReports   QuestionReport[]  @relation("ReportResolver")
  createdQuestions  Question[]        @relation("QuestionCreatedBy")
  reviewedQuestions Question[]        @relation("QuestionReviewedBy")
  importedQuestions Question[]        @relation("QuestionImportedBy")
  questionVersions  QuestionVersion[]
  sourcesConfirmed  Source[]
  sourceFiles       SourceFile[]
  questionAssets    QuestionAsset[]
  importBatches     ImportBatch[]     @relation("ImportCreatedBy")
  importsConfirmed  ImportBatch[]     @relation("ImportRightsConfirmedBy")
  auditLogs         AuditLog[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Content sources & files ────────────────────────────────────────────────

/// Who owns a set of questions and who confirmed we may publish them.
model Source {
  id                  String    @id @default(cuid())
  name                String
  owner               String
  notes               String?
  /// Exact wording of the rights confirmation the user ticked.
  rightsStatement     String
  rightsConfirmedById String
  rightsConfirmedAt   DateTime
  /// Set when permission is withdrawn; all its questions are unpublished.
  withdrawnAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rightsConfirmedBy User          @relation(fields: [rightsConfirmedById], references: [id])
  files             SourceFile[]
  questions         Question[]
  importBatches     ImportBatch[]
}

enum SourceFileKind {
  QUESTIONS_PDF
  ANSWER_KEY_PDF
  SPREADSHEET
}

/// An original uploaded file. Stored privately; never publicly downloadable.
model SourceFile {
  id           String         @id @default(cuid())
  sourceId     String
  kind         SourceFileKind
  storageKey   String         @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  pageCount    Int?
  uploadedById String
  uploadedAt   DateTime       @default(now())

  source        Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  uploadedBy    User          @relation(fields: [uploadedById], references: [id])
  questions     Question[]
  importBatches ImportBatch[]

  @@index([sourceId])
}

enum ImportKind {
  SPREADSHEET
  PDF
}

enum ImportStatus {
  PENDING
  PROCESSING
  READY // parsed, questions are in the review queue
  FAILED
}

model ImportBatch {
  id                  String       @id @default(cuid())
  kind                ImportKind
  status              ImportStatus @default(PENDING)
  sourceId            String
  fileId              String?
  section             Section?
  defaultDifficulty   Difficulty?
  codePrefix          String?
  totalItems          Int          @default(0)
  processedItems      Int          @default(0)
  /// Per-row / per-page messages produced while parsing.
  log                 Json?
  error               String?
  /// Every upload repeats the rights confirmation; who ticked it and when.
  rightsConfirmedById String
  rightsConfirmedAt   DateTime
  createdById         String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  source            Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  file              SourceFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdBy         User        @relation("ImportCreatedBy", fields: [createdById], references: [id])
  rightsConfirmedBy User        @relation("ImportRightsConfirmedBy", fields: [rightsConfirmedById], references: [id])
  questions         Question[]

  @@index([sourceId])
}

// ─── Questions ──────────────────────────────────────────────────────────────

enum Section {
  RW
  MATH
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MCQ
  SPR // student-produced response
}

enum QuestionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  RETIRED
}

enum QuestionOrigin {
  IMPORTED
  AI_DRAFTED
  MANUAL
}

model Question {
  id                    String         @id @default(cuid())
  /// The centre's own code, e.g. LC-M-ALG-0001. Unique.
  code                  String         @unique
  section               Section
  /// Domain key from src/lib/taxonomy.ts, e.g. "ALGEBRA"
  domain                String
  /// Skill key from src/lib/taxonomy.ts, e.g. "LINEAR_EQUATIONS_ONE_VAR"
  skill                 String
  difficulty            Difficulty
  /// Numeric difficulty, calibrated from student results later (0..1, higher = harder).
  difficultyRating      Float?
  type                  QuestionType
  /// Markdown (+ LaTeX). Questions stay in English like the real SAT.
  passage               String?
  stem                  String
  /// MCQ only: [{ "key": "A", "text": "..." }, ...] (exactly four)
  choices               Json?
  /// MCQ: ["B"]. SPR: every accepted form, e.g. ["1/2", ".5", "0.5"].
  correctAnswers        String[]
  explanation           String?
  /// { "A": "why A is wrong", ... }
  wrongChoiceRationales Json?
  tags                  String[]
  status                QuestionStatus @default(DRAFT)
  origin                QuestionOrigin
  /// Automatic review flags, e.g. MISSING_ANSWER (see src/lib/questions/flags.ts)
  flags                 String[]
  /// Normalized text for near-duplicate detection.
  fingerprint           String         @default("")
  /// Development sample — removed by `pnpm samples:remove` before launch.
  isSample              Boolean        @default(false)

  // Provenance
  sourceId      String?
  sourceFileId  String?
  sourcePage    Int?
  importBatchId String?
  /// Row number (spreadsheet) or question number (PDF) in the original file.
  sourceRef     String?
  importedById  String?
  importedAt    DateTime?

  version      Int       @default(1)
  createdById  String?
  reviewedById String?
  reviewedAt   DateTime?
  publishedAt  DateTime?
  reportCount  Int       @default(0)

  // Running stats for calibration
  attemptCount Int @default(0)
  correctCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source      Source?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceFile  SourceFile?  @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importedBy  User?        @relation("QuestionImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy  User?        @relation("QuestionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  assets    QuestionAsset[]
  versions  QuestionVersion[]
  reports   QuestionReport[]
  responses Response[]

  @@index([status, section, domain, skill, difficulty])
  @@index([sourceId])
  @@index([importBatchId])
  @@index([isSample])
}

/// Image attached to a question (figure, graph, table). Referenced from Markdown as ![alt](asset:<id>).
model QuestionAsset {
  id           String   @id @default(cuid())
  questionId   String?
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  alt          String?
  uploadedById String?
  createdAt    DateTime @default(now())

  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([questionId])
}

/// Full snapshot after every save.
model QuestionVersion {
  id         String   @id @default(cuid())
  questionId String
  version    Int
  snapshot   Json
  changeNote String?
  editedById String?
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  editedBy User?    @relation(fields: [editedById], references: [id], onDelete: SetNull)

  @@unique([questionId, version])
}

enum ReportReason {
  WRONG_ANSWER
  TYPO
  UNCLEAR
  FIGURE
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model QuestionReport {
  id           String       @id @default(cuid())
  questionId   String
  userId       String?
  reason       ReportReason
  message      String?
  status       ReportStatus @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime     @default(now())

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User?    @relation("ReportAuthor", fields: [userId], references: [id], onDelete: SetNull)
  resolvedBy User?    @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([questionId, userId])
  @@index([status])
}

// ─── Practice & tests ───────────────────────────────────────────────────────

enum AttemptKind {
  DRILL
  MOCK
  SECTION
  MODULE
  DAILY
  REVIEW
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum FeedbackMode {
  IMMEDIATE // check each answer as you go (drills)
  END // see results when the module ends (tests)
}

model Attempt {
  id            String        @id @default(cuid())
  userId        String
  kind          AttemptKind
  status        AttemptStatus @default(IN_PROGRESS)
  /// Snapshot of the options used to build it (filters, counts, timing).
  config        Json
  feedbackMode  FeedbackMode  @default(END)
  timed         Boolean       @default(false)
  currentModule Int           @default(0)
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  correctCount  Int?
  totalCount    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  modules AttemptModule[]

  @@index([userId, createdAt])
}

model AttemptModule {
  id           String    @id @default(cuid())
  attemptId    String
  /// Order inside the attempt (0-based)
  index        Int
  section      Section?
  /// 1 or 2 for adaptive tests
  moduleNumber Int?
  /// Adaptive module-2 path, e.g. "lower" | "upper" (Phase 3)
  variant      String?
  timeLimitSec Int?
  startedAt    DateTime?
  submittedAt  DateTime?

  attempt   Attempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  responses Response[]

  @@unique([attemptId, index])
}

model Response {
  id          String    @id @default(cuid())
  moduleId    String
  questionId  String
  position    Int
  answer      String?
  isCorrect   Boolean?
  flagged     Boolean   @default(false)
  eliminated  String[]
  timeSpentMs Int       @default(0)
  answeredAt  DateTime?
  /// When the answer was checked (immediate feedback) or graded (module end).
  gradedAt    DateTime?

  module   AttemptModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  question Question      @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([moduleId, position])
  @@unique([moduleId, questionId])
  @@index([questionId])
}

// ─── Platform ───────────────────────────────────────────────────────────────

/// Fixed-window counters for rate limiting (works across serverless instances).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// Admin actions worth keeping a record of.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}
